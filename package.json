{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Personal portfolio: a home page and one case study page per project.",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "css": "sass sass/main.scss css/style.css --no-source-map --style=expanded",
