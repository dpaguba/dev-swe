---
import Base from './Base.astro'

const { title, description, image, heading, lines, hero = 'plain', credit } = Astro.props
---

<Base
  title={`${title} | Dmytro Pahuba`}
  tab={`${title} | DP`}
  description={description}
  image={image}
  type="article"
>
  <section class={`project-cs-hero project-cs-hero--${hero}`}>
    <div class="project-cs-hero__content">
      <h1 class="heading-primary">{heading}</h1>
      <div class="project-cs-hero__info">
        <p class="text-primary funnel">
          {lines.map((line, index) => (
          <>
            {index > 0 && ' '}
            <span>{line}</span>
          </>
        ))}
        </p>
      </div>
      <div class="project-cs-hero__cta">
        <a href="#details" class="btn btn--bg">Read the case study</a>
      </div>
    </div>
    {credit && <p class="project-cs-hero__credit" set:html={credit} />}
  </section>

  <section id="details" class="project-details">
    <div class="main-container">
      <div class="project-details__content">
        <div class="project-details__content-main">
          <slot />
        </div>
      </div>
    </div>
  </section>
</Base>
